# Copy this file to .env and fill in your local values

# Postgres running on your PC. Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gymos

# Random long string used to encrypt session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
